
import os
import requests
from flask import Flask, request

app = Flask(__name__)

VERIFY_TOKEN = os.environ.get("VERIFY_TOKEN", "naroma_verify_2026")
ACCESS_TOKEN = os.environ.get("ACCESS_TOKEN")
GRAPH_VERSION = os.environ.get("GRAPH_VERSION")
 
@app.route("/webhook", methods=["GET", "POST"])
def webhook():
    if request.method == "GET":
        if request.args.get("hub.verify_token") == VERIFY_TOKEN:
            return request.args.get("hub.challenge", ""), 200
        return "Verification failed", 403

    data = request.get_json(silent=True) or {}

    try:
        for entry in data.get("entry", []):
            for change in entry.get("changes", []):
                value = change.get("value", {})
                messages = value.get("messages", [])

                for message in messages:
                    if message.get("type") != "text":
                        continue

                    choice = message["text"]["body"].strip()
                    recipient = message["from"]
                    phone_id = value["metadata"]["phone_number_id"]

                    replies = {
                        "1": "Let's discover your scent 🤍 Visit: https://naromafragrance.com/discover-your-scent/",
                        "2": "Explore Naroma fragrances and prices: https://naromafragrance.com/shop/",
                        "3": "Delivery details will be confirmed according to your location.",
                        "4": "We currently offer Cash on Delivery.",
                        "5": "Our exchange and return policy: https://naromafragrance.com/return-exchange-policy/",
                        "6": "Our team will be happy to assist you. 🤍"
                    }

                    reply = replies.get(choice)

                    if reply and ACCESS_TOKEN and GRAPH_VERSION:
                        url = f"https://graph.facebook.com/{GRAPH_VERSION}/{phone_id}/messages"
                        requests.post(
                            url,
                            headers={"Authorization": f"Bearer {ACCESS_TOKEN}"},
                            json={
                                "messaging_product": "whatsapp",
                                "to": recipient,
                                "type": "text",
                                "text": {"body": reply}
                            },
                            timeout=15
                        )

    except Exception as error:
        print("Webhook error:", error)

    return "OK", 200

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 10000)))
